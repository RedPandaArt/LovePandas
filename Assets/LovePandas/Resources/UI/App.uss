/* Тёплая уютная палитра. Размеры в px при референсе 1080×1920 (см. Bootstrap, PanelSettings). */

.root {
    flex-grow: 1;
    justify-content: space-between;
    padding: 48px 32px 56px 32px;
    -unity-font-style: normal;
    color: rgb(74, 46, 36);
}

/* ---------- Верхняя панель ---------- */
.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}
.chip {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 250, 242, 0.92);
    border-radius: 40px;
    padding: 14px 28px;
    font-size: 40px;
    -unity-font-style: bold;
}
.player-name { font-size: 36px; }
.switch-btn {
    font-size: 30px;
    margin-left: 16px;
    padding: 10px 22px;
    border-radius: 30px;
    background-color: rgb(245, 214, 196);
    border-width: 0;
    color: rgb(74, 46, 36);
}

/* ---------- Нижние кнопки ---------- */
.nav {
    flex-direction: row;
    justify-content: space-between;
}
.nav-btn {
    flex-grow: 1;
    height: 150px;
    margin: 0 10px;
    border-radius: 40px;
    border-width: 0;
    background-color: rgb(232, 110, 72);
    color: rgb(255, 255, 255);
    font-size: 40px;
    -unity-font-style: bold;
}

/* ---------- Шторка экрана ---------- */
.sheet-backdrop {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    justify-content: flex-end;
}
.sheet {
    height: 62%;
    background-color: rgb(255, 248, 238);
    border-top-left-radius: 56px;
    border-top-right-radius: 56px;
    padding: 36px 32px 40px 32px;
}
.sheet-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}
.sheet-title { font-size: 52px; -unity-font-style: bold; }
.close-btn {
    width: 96px; height: 96px;
    border-radius: 48px;
    border-width: 0;
    font-size: 44px;
    background-color: rgb(245, 214, 196);
    color: rgb(74, 46, 36);
}
.section-title {
    font-size: 34px;
    -unity-font-style: bold;
    margin: 18px 0 10px 0;
    color: rgb(150, 100, 80);
}
.empty { font-size: 32px; color: rgb(170, 130, 110); margin: 8px 0 16px 0; }

/* ---------- Карточка задания ---------- */
.quest {
    background-color: rgb(255, 255, 255);
    border-radius: 32px;
    padding: 22px 26px;
    margin-bottom: 14px;
}
.quest-text { font-size: 36px; white-space: normal; }
.quest-meta {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
}
.quest-reward { font-size: 34px; -unity-font-style: bold; color: rgb(214, 140, 20); }
.quest-status { font-size: 28px; color: rgb(150, 110, 90); }
.quest-actions { flex-direction: row; }

.action-btn {
    font-size: 30px;
    padding: 12px 24px;
    margin-left: 12px;
    border-radius: 28px;
    border-width: 0;
    background-color: rgb(232, 110, 72);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}
.action-btn.secondary {
    background-color: rgb(245, 214, 196);
    color: rgb(74, 46, 36);
}

/* ---------- Форма нового задания ---------- */
.form { background-color: rgb(255, 255, 255); border-radius: 32px; padding: 20px; margin-bottom: 16px; }
.form-row { flex-direction: row; align-items: center; margin-top: 12px; }
.input { font-size: 34px; }
.input > .unity-base-text-field__input {
    border-radius: 20px;
    padding: 14px 18px;
    background-color: rgb(250, 240, 230);
    border-width: 0;
    color: rgb(74, 46, 36);
}
.input-text { flex-grow: 1; }
.input-price { width: 220px; }

/* ---------- Сетка магазина и гардероба ---------- */
.grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.item {
    width: 48%;
    height: 250px;
    margin-bottom: 18px;
    border-radius: 32px;
    border-width: 0;
    background-color: rgb(255, 255, 255);
    padding: 18px;
    align-items: center;
    justify-content: space-between;
}
.item.equipped { border-width: 6px; border-color: rgb(232, 110, 72); }
.item.owned .item-price { color: rgb(90, 160, 100); }
.item-swatch { width: 90px; height: 90px; border-radius: 45px; }
.item-name { font-size: 32px; -unity-text-align: middle-center; white-space: normal; }
.item-price { font-size: 30px; -unity-font-style: bold; color: rgb(214, 140, 20); }

/* ---------- Всплывашка ---------- */
.toast {
    position: absolute;
    left: 60px; right: 60px; top: 190px;
    padding: 22px 30px;
    border-radius: 36px;
    background-color: rgba(74, 46, 36, 0.92);
    color: rgb(255, 255, 255);
    font-size: 34px;
    -unity-text-align: middle-center;
    white-space: normal;
}
.hidden { display: none; }

/* ---------- Крестик закрытия (две полоски вместо символа ✕) ---------- */
.close-btn { align-items: center; justify-content: center; padding: 0; }
.x-bar {
    position: absolute;
    width: 42px; height: 6px;
    border-radius: 3px;
    background-color: rgb(74, 46, 36);
}
.x-bar-a { rotate: 45deg; }
.x-bar-b { rotate: -45deg; }

/* ---------- Инвентарь: дощечка слева ---------- */
.inv-panel {
    position: absolute;
    left: 0; top: 140px; bottom: 20px;
    width: 56%;
    -unity-background-scale-mode: stretch-to-fill;
    padding: 70px 44px 70px 40px;
}
.inv-header { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 14px; }
.inv-title {
    font-size: 46px;
    -unity-font-style: bold;
    color: rgb(255, 246, 228);
    text-shadow: 0 3px 4px rgba(60, 30, 10, 0.8);
}
.inv-panel .close-btn { width: 80px; height: 80px; border-radius: 40px; background-color: rgba(255, 240, 220, 0.9); }
.inv-tabs { flex-direction: row; flex-wrap: wrap; margin-bottom: 14px; }
.inv-tab {
    width: 48%;
    height: 72px;
    margin: 0 1% 10px 1%;
    border-radius: 24px;
    border-width: 0;
    background-color: rgba(70, 40, 20, 0.55);
    color: rgb(255, 240, 220);
    font-size: 28px;
    -unity-font-style: bold;
}
.inv-tab.selected { background-color: rgb(232, 110, 72); color: rgb(255, 255, 255); }
.inv-list { flex-grow: 1; }
.inv-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.inv-card {
    width: 48%;
    height: 250px;
    margin: 0 0 14px 0;
    padding: 10px;
    border-radius: 26px;
    border-width: 5px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(255, 248, 236, 0.9);
    align-items: center;
    justify-content: space-between;
}
.inv-card.locked { background-color: rgba(225, 215, 200, 0.82); }
.inv-card.equipped { border-color: rgb(232, 110, 72); }
.inv-card.trying { border-color: rgb(40, 170, 160); }
.inv-icon { width: 170px; height: 160px; -unity-background-scale-mode: scale-to-fit; border-radius: 75px; }
.inv-name { font-size: 24px; -unity-text-align: middle-center; white-space: normal; color: rgb(74, 46, 36); }
.inv-card.locked .inv-name { color: rgb(120, 105, 95); }
.inv-price {
    flex-direction: row; align-items: center;
    padding: 2px 14px;
    border-radius: 16px;
    background-color: rgb(74, 46, 36);
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 214, 120);
}
.inv-price .coin { width: 24px; height: 24px; margin-right: 6px; border-width: 3px; }
.inv-badge { font-size: 22px; -unity-font-style: bold; color: rgb(232, 110, 72); }
.inv-card.trying .inv-badge { color: rgb(40, 150, 140); }
.inv-buy { padding-top: 12px; align-items: stretch; }
.inv-buy-label { font-size: 26px; color: rgb(255, 246, 228); -unity-text-align: middle-center; margin-bottom: 8px; text-shadow: 0 2px 3px rgba(60, 30, 10, 0.8); }
.inv-buy-btn { height: 96px; margin: 0; font-size: 34px; border-radius: 32px; }
.inv-buy-btn:disabled { background-color: rgb(150, 130, 120); }
.inv-rotate { position: absolute; left: 56%; right: 0; top: 140px; bottom: 0; }
.inv-open .toast { left: 58%; right: 16px; top: 150px; font-size: 28px; }

/* Метка dev-сборки (LP_DEV) */
.dev-badge {
    position: absolute;
    left: 32px; top: 130px;
    padding: 6px 16px;
    border-radius: 16px;
    background-color: rgba(200, 30, 60, 0.85);
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-style: bold;
}

/* ---------- Первый вход ---------- */
.onboard-card { height: auto; padding-bottom: 72px; }
.onboard-card > .sheet-title { margin-bottom: 20px; white-space: normal; }
.hint { font-size: 32px; color: rgb(150, 110, 90); margin: 18px 0 12px 0; white-space: normal; }
.action-btn.big { height: 120px; margin: 20px 0 0 0; font-size: 40px; border-radius: 40px; }
.choice-row { flex-direction: row; justify-content: space-between; }
.choice-btn {
    width: 48%;
    height: 140px;
    border-radius: 36px;
    border-width: 6px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgb(255, 255, 255);
    color: rgb(74, 46, 36);
    font-size: 38px;
    -unity-font-style: bold;
}
/* стандартная подсветка наведения/фокуса Unity выглядела как «уже выбрано» — гасим её */
.choice-btn:hover, .choice-btn:focus, .choice-btn:active { border-color: rgba(0, 0, 0, 0); background-color: rgb(255, 255, 255); }
.choice-btn.selected, .choice-btn.selected:hover, .choice-btn.selected:focus { border-color: rgb(232, 110, 72); }
.invite-code {
    font-size: 110px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 12px;
    color: rgb(232, 110, 72);
    margin: 12px 0;
}

/* ---------- Монетка ---------- */
.price { flex-direction: row; align-items: center; }
.coin {
    width: 34px; height: 34px;
    margin-right: 10px;
    border-radius: 17px;
    background-color: rgb(255, 200, 60);
    border-width: 4px;
    border-color: rgb(214, 140, 20);
}
