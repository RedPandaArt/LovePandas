/* Тёплая уютная палитра. Размеры в px при референсе 1080×1920 (см. Bootstrap, PanelSettings). */

.root {
    flex-grow: 1;
    justify-content: space-between;
    padding: 48px 32px 56px 32px;
    -unity-font-style: normal;
    color: rgb(74, 46, 36);
}

/* ---------- Верхняя панель ---------- */
.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}
.chip {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 250, 242, 0.92);
    border-radius: 40px;
    padding: 14px 28px;
    font-size: 40px;
    -unity-font-style: bold;
}
.player-name { font-size: 36px; }
.switch-btn {
    font-size: 30px;
    margin-left: 16px;
    padding: 10px 22px;
    border-radius: 30px;
    background-color: rgb(245, 214, 196);
    border-width: 0;
    color: rgb(74, 46, 36);
}

/* ---------- Нижние кнопки ---------- */
.nav {
    flex-direction: row;
    justify-content: space-between;
}
.nav-btn {
    flex-grow: 1;
    height: 150px;
    margin: 0 10px;
    border-radius: 40px;
    border-width: 0;
    background-color: rgb(232, 110, 72);
    color: rgb(255, 255, 255);
    font-size: 40px;
    -unity-font-style: bold;
}

/* ---------- Шторка экрана ---------- */
.sheet-backdrop {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    justify-content: flex-end;
}
.sheet {
    height: 62%;
    background-color: rgb(255, 248, 238);
    border-top-left-radius: 56px;
    border-top-right-radius: 56px;
    padding: 36px 32px 40px 32px;
}
.sheet-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}
.sheet-title { font-size: 52px; -unity-font-style: bold; }
.close-btn {
    width: 96px; height: 96px;
    border-radius: 48px;
    border-width: 0;
    font-size: 44px;
    background-color: rgb(245, 214, 196);
    color: rgb(74, 46, 36);
}
.section-title {
    font-size: 34px;
    -unity-font-style: bold;
    margin: 18px 0 10px 0;
    color: rgb(150, 100, 80);
}
.empty { font-size: 32px; color: rgb(170, 130, 110); margin: 8px 0 16px 0; }

/* ---------- Карточка задания ---------- */
.quest {
    background-color: rgb(255, 255, 255);
    border-radius: 32px;
    padding: 22px 26px;
    margin-bottom: 14px;
}
.quest-text { font-size: 36px; white-space: normal; }
.quest-meta {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
}
.quest-reward { font-size: 34px; -unity-font-style: bold; color: rgb(214, 140, 20); }
.quest-status { font-size: 28px; color: rgb(150, 110, 90); }
.quest-actions { flex-direction: row; }

.action-btn {
    font-size: 30px;
    padding: 12px 24px;
    margin-left: 12px;
    border-radius: 28px;
    border-width: 0;
    background-color: rgb(232, 110, 72);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}
.action-btn.secondary {
    background-color: rgb(245, 214, 196);
    color: rgb(74, 46, 36);
}

/* ---------- Форма нового задания ---------- */
.form { background-color: rgb(255, 255, 255); border-radius: 32px; padding: 20px; margin-bottom: 16px; }
.form-row { flex-direction: row; align-items: center; margin-top: 12px; }
.input { font-size: 34px; }
.input > .unity-base-text-field__input {
    border-radius: 20px;
    padding: 14px 18px;
    background-color: rgb(250, 240, 230);
    border-width: 0;
    color: rgb(74, 46, 36);
}
.input-text { flex-grow: 1; }
.input-price { width: 220px; }

/* ---------- Сетка магазина и гардероба ---------- */
.grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.item {
    width: 48%;
    height: 250px;
    margin-bottom: 18px;
    border-radius: 32px;
    border-width: 0;
    background-color: rgb(255, 255, 255);
    padding: 18px;
    align-items: center;
    justify-content: space-between;
}
.item.equipped { border-width: 6px; border-color: rgb(232, 110, 72); }
.item.owned .item-price { color: rgb(90, 160, 100); }
.item-swatch { width: 90px; height: 90px; border-radius: 45px; }
.item-name { font-size: 32px; -unity-text-align: middle-center; white-space: normal; }
.item-price { font-size: 30px; -unity-font-style: bold; color: rgb(214, 140, 20); }

/* ---------- Всплывашка ---------- */
.toast {
    position: absolute;
    left: 60px; right: 60px; top: 190px;
    padding: 22px 30px;
    border-radius: 36px;
    background-color: rgba(74, 46, 36, 0.92);
    color: rgb(255, 255, 255);
    font-size: 34px;
    -unity-text-align: middle-center;
    white-space: normal;
}
.hidden { display: none; }

/* ---------- Крестик закрытия (две полоски вместо символа ✕) ---------- */
.close-btn { align-items: center; justify-content: center; padding: 0; }
.x-bar {
    position: absolute;
    width: 42px; height: 6px;
    border-radius: 3px;
    background-color: rgb(74, 46, 36);
}
.x-bar-a { rotate: 45deg; }
.x-bar-b { rotate: -45deg; }

/* ---------- Инвентарь поверх 3D-доски (BoardView) ---------- */
.inv-hit { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.inv-labels { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
/* ценник/отметка под гнездом: позицию задаёт код (центр по x — translate) */
.inv-slot-label {
    position: absolute;
    translate: -50% -50%;
    flex-direction: row;
    align-items: center;
    padding: 4px 16px;
    border-radius: 18px;
    background-color: rgb(74, 46, 36);
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(255, 214, 120);
}
.inv-slot-label .coin { width: 26px; height: 26px; margin-right: 8px; border-width: 3px; }
.inv-slot-label.equipped { background-color: rgb(232, 110, 72); color: rgb(255, 255, 255); }
.inv-slot-label.trying { background-color: rgb(40, 150, 140); color: rgb(255, 255, 255); }
.inv-slot-label.equipped .coin, .inv-slot-label.trying .coin { display: none; }
.inv-close {
    position: absolute;
    translate: -50% -50%;
    width: 84px; height: 84px;
    border-radius: 42px;
    background-color: rgb(255, 240, 220);
    border-width: 4px;
    border-color: rgb(120, 78, 45);
}
.inv-buy {
    position: absolute;
    left: 3%; width: 52%; bottom: 28px;
    align-items: stretch;
}
.inv-buy-label { font-size: 28px; color: rgb(255, 246, 228); -unity-text-align: middle-center; margin-bottom: 8px; text-shadow: 0 2px 3px rgba(40, 20, 10, 0.9); }
.inv-buy-btn { height: 100px; margin: 0; font-size: 34px; border-radius: 34px; border-width: 4px; border-color: rgb(150, 70, 40); }
.inv-buy-btn:disabled { background-color: rgb(150, 130, 120); border-color: rgb(110, 95, 85); }
.inv-open .toast { left: 58%; right: 16px; top: 150px; font-size: 28px; }

/* ---------- Доска заказов (OrdersPanel поверх QuestBoardView) ---------- */
.orders-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.orders-modal { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(20, 12, 6, 0.35); }
/* у всех привязанных к 3D элементов позицию задаёт код, центр — через translate */
.orders-title, .orders-header, .orders-empty, .orders-new, .note, .modal-field, .modal-price, .modal-submit {
    position: absolute;
    translate: -50% -50%;
}
.orders-title {
    font-size: 46px;
    -unity-font-style: bold;
    color: rgb(255, 238, 205);
    text-shadow: 0 3px 3px rgba(40, 20, 8, 0.9);
}
.orders-header { font-size: 30px; -unity-font-style: bold; color: rgb(90, 52, 28); }
.orders-empty {
    width: 40%;
    font-size: 26px;
    color: rgb(255, 238, 205);
    -unity-text-align: middle-center;
    white-space: normal;
    text-shadow: 0 2px 3px rgba(40, 20, 8, 0.9);
}
.orders-new {
    width: 380px; height: 96px;
    padding-left: 56px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(90, 52, 28);
}
/* отступы листка задаёт код от ширины листка: проценты в UI Toolkit считаются от родителя (всего экрана) */
.note { justify-content: space-between; }
/* листок фиксированной высоты: сжимается только текст, нижний ряд с кнопками — никогда */
.note-text { white-space: normal; color: rgb(60, 36, 22); -unity-font-style: bold; flex-grow: 1; flex-shrink: 1; overflow: hidden; }
.note-status, .note-bottom, .note-btn, .note-actions { flex-shrink: 0; }
.note-bottom { flex-direction: row; justify-content: space-between; align-items: center; }
.note-reward { flex-direction: row; align-items: center; color: rgb(170, 100, 20); -unity-font-style: bold; }
/* размеры шрифтов и монетки на листке задаёт код от ширины листка (USS не знает em) */
.note-reward .coin { margin-right: 6px; border-width: 3px; }
.note-status { color: rgb(130, 90, 60); }
.note-actions { flex-direction: row; justify-content: flex-end; }
.note-btn {
    margin: 0 0 0 10px;
    padding: 6px 20px;
    min-height: 48px;
    border-radius: 18px;
    border-width: 0;
    background-color: rgb(232, 110, 72);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}
.note-btn.secondary { background-color: rgb(120, 78, 45); color: rgb(255, 240, 220); }
.modal-field { height: 180px; font-size: 32px; }
.modal-field > .unity-base-text-field__input { background-color: rgba(255, 246, 228, 0.95); -unity-text-align: upper-left; white-space: normal; }
.modal-price { width: 240px; font-size: 32px; }
.modal-price > .unity-base-text-field__input { background-color: rgba(255, 246, 228, 0.95); }
.modal-submit { width: 280px; height: 92px; margin: 0; font-size: 34px; border-radius: 32px; }

/* ---------- В гостях (VisitPanel) и пузырёк «входящих» (InboxBubble) ---------- */
.visit-chip { padding-left: 18px; }
.visit-chip-heart { width: 36px; height: 36px; margin-right: 10px; -unity-background-scale-mode: scale-to-fit; }
.visiting .top-bar { display: none; }
.visit-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.visit-touch { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.visit-title {
    position: absolute; left: 0; right: 0; top: 56px;
    -unity-text-align: middle-center;
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(255, 246, 228);
    text-shadow: 0 3px 4px rgba(40, 20, 8, 0.85);
}
.visit-hint {
    position: absolute; left: 60px; right: 60px; top: 170px;
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 28px;
    color: rgb(255, 246, 228);
    text-shadow: 0 2px 3px rgba(40, 20, 8, 0.85);
}
.visit-home { position: absolute; left: 25%; right: 25%; bottom: 56px; flex-grow: 0; margin: 0; }
.visit-menu {
    position: absolute;
    flex-direction: row;
    translate: -50% -130%;
}
.visit-action {
    width: 170px; height: 196px;
    margin: 0 10px;
    padding: 10px 0;
    border-radius: 40px;
    border-width: 4px;
    border-color: rgb(232, 110, 72);
    background-color: rgba(255, 248, 238, 0.96);
    align-items: center;
    justify-content: space-between;
}
.visit-action-icon { width: 120px; height: 120px; -unity-background-scale-mode: scale-to-fit; }
.visit-action-label { font-size: 26px; -unity-font-style: bold; color: rgb(74, 46, 36); }
.inbox-bubble {
    position: absolute;
    width: 190px; height: 190px;
    translate: -50% -50%;
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
}
.inbox-heart { width: 96px; height: 96px; -unity-background-scale-mode: scale-to-fit; }
.inbox-card {
    position: absolute; left: 80px; right: 80px; top: 30%;
    padding: 40px 40px 44px 40px;
    border-radius: 48px;
    background-color: rgb(255, 248, 238);
    border-width: 5px;
    border-color: rgb(240, 150, 170);
    align-items: center;
}
.inbox-card-heart { width: 110px; height: 110px; margin-bottom: 12px; -unity-background-scale-mode: scale-to-fit; }
.inbox-card-title { font-size: 40px; -unity-font-style: bold; color: rgb(74, 46, 36); -unity-text-align: middle-center; white-space: normal; }
.inbox-card-text { font-size: 34px; color: rgb(150, 90, 70); -unity-text-align: middle-center; white-space: normal; margin: 16px 0 8px 0; }
.inbox-card .action-btn.big { align-self: stretch; }

/* ---------- Главный экран: 3D-медальоны (HudButtons) и монеты только в инвентаре ---------- */
.hud-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.hud-hit {
    position: absolute;
    translate: -50% -50%;
    margin: 0; padding: 0;
    border-width: 0;
    border-radius: 999px;
    background-color: rgba(0, 0, 0, 0);
}
.hud-hit:hover, .hud-hit:active, .hud-hit:focus { background-color: rgba(0, 0, 0, 0); }
.coins-chip { position: absolute; left: 32px; top: 48px; display: none; }
.inv-open .coins-chip { display: flex; }

/* Метка dev-сборки (LP_DEV) */
.dev-badge {
    position: absolute;
    left: 32px; top: 130px;
    padding: 6px 16px;
    border-radius: 16px;
    background-color: rgba(200, 30, 60, 0.85);
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-style: bold;
}

/* ---------- Первый вход ---------- */
.onboard-card { height: auto; padding-bottom: 72px; }
.onboard-card > .sheet-title { margin-bottom: 20px; white-space: normal; }
.hint { font-size: 32px; color: rgb(150, 110, 90); margin: 18px 0 12px 0; white-space: normal; }
.action-btn.big { height: 120px; margin: 20px 0 0 0; font-size: 40px; border-radius: 40px; }
.choice-row { flex-direction: row; justify-content: space-between; }
.choice-btn {
    width: 48%;
    height: 140px;
    border-radius: 36px;
    border-width: 6px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgb(255, 255, 255);
    color: rgb(74, 46, 36);
    font-size: 38px;
    -unity-font-style: bold;
}
/* стандартная подсветка наведения/фокуса Unity выглядела как «уже выбрано» — гасим её */
.choice-btn:hover, .choice-btn:focus, .choice-btn:active { border-color: rgba(0, 0, 0, 0); background-color: rgb(255, 255, 255); }
.choice-btn.selected, .choice-btn.selected:hover, .choice-btn.selected:focus { border-color: rgb(232, 110, 72); }
.invite-code {
    font-size: 110px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 12px;
    color: rgb(232, 110, 72);
    margin: 12px 0;
}

/* ---------- Монетка ---------- */
.price { flex-direction: row; align-items: center; }
.coin {
    width: 34px; height: 34px;
    margin-right: 10px;
    border-radius: 17px;
    background-color: rgb(255, 200, 60);
    border-width: 4px;
    border-color: rgb(214, 140, 20);
}
